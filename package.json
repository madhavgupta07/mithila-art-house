{
  "name": "mithila-art-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A premium React storefront for Mithila / Madhubani inspired art (sample catalogue).",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "art:generate": "python scripts/generate_art.py",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:seed": "npm --prefix server run seed",
    "dev:full": "node scripts/start.js --full",
    "dev:full:core": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.27.0",
    "swiper": "^11.1.14",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
