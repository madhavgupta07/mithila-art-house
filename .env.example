# Copy to .env.local and replace the example values before going live.
# Nothing here is required to run the storefront.

VITE_SITE_URL=https://mithila-art.example
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_BUSINESS_ADDRESS=
VITE_INSTAGRAM_URL=

# Optional MERN backend. Leave empty for the frontend-only storefront (no /api requests).
# Set to /api when the Express server is running (Vite proxies it to :4000).
# A full URL also works when the API is hosted on a different origin.
VITE_API_URL=

# Razorpay TEST-mode key ID only. Never put a live key in a front-end env file.
# Leaving this empty keeps checkout in no-payment mode.
VITE_RAZORPAY_KEY_ID=

# Shipping is an illustrative estimate until a real backend calculates it.
VITE_SHIPPING_FEE=99
VITE_FREE_SHIPPING_ABOVE=4999

# Optional JSON array of sample coupon codes.
# Example: [{"code":"WELCOME10","type":"percent","value":10,"minSubtotal":0}]
VITE_COUPONS=
